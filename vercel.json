{
  "version": 2,
  "builds": [
    {
      "src": "api/vmos.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "features.css",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    }
    ,{
      "src": "fixes.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/vmos/?$",
      "dest": "/api/vmos.js"
    },
    {
      "src": "/styles.css",
      "dest": "/styles.css"
    },
    {
      "src": "/features.css",
      "dest": "/features.css"
    },
    {
      "src": "/app.js",
      "dest": "/app.js"
    },
    {
      "src": "/fixes.js",
      "dest": "/fixes.js"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
